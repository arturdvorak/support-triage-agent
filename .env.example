ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LangSmith (optional). Leave LANGSMITH_API_KEY blank to disable tracing.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGSMITH_PROJECT=triage-agent-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional. After the first run caches the embedding model, set this to 1 to
# skip the Hugging Face Hub check and silence its warning. Leave unset on a
# fresh machine so the model can download the first time.
# HF_HUB_OFFLINE=1
